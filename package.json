{
  "name": "dsh-dev-plan-presets",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSH 开发规划预设：昂贵主模型只做规划与静态复核；查证/遍历/落盘交给 standard 子代理，角色约束由 dev-plan 在每次派遣时以固定模板附带（纯静态组合）。",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/dev-plan.patch.yml": "./presets/dev-plan.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "presets/dev-plan.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "detail.md",
    "scripts/verify-presets.mjs"
  ],
  "scripts": {
    "verify": "node scripts/verify-presets.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/dev-plan.patch.yml"
      ]
    }
  }
}
